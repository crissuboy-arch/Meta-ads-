{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OFENSIVA CRIATIVA TRÁFEGO IA",
  "version": "1.0.0",
  "identifier": "com.ofensivatrafegoia.app",
  "build": {
    "frontendDist": "https://app.ofensivacriativa.com"
  },
  "app": {
    "windows": [
      {
        "title": "OFENSIVA CRIATIVA TRÁFEGO IA",
        "url": "https://app.ofensivacriativa.com",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [
      "../local_engine/*.py",
      "../local_engine/requirements.txt"
    ]
  }
}
