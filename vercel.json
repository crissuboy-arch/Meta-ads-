{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "downloads/**"
    }
  },
  "rewrites": [
    {
      "destination": "/api/index/api/:path*",
      "source": "/api/:path*"
    },
    {
      "destination": "/api/index/:path*",
      "source": "/:path*"
    }
  ]
}
