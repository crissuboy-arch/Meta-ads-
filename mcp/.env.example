# Copie para mcp/.env e preencha — ESTE ARQUIVO NUNCA VAI PARA O GIT
# O token quem gera é você em developers.facebook.com (passo a passo no README-MCP.md)

# Token de acesso da Meta (user token ou system user) com permissões ads_read + ads_management
META_ACCESS_TOKEN=

# Conta de anúncios (só números, sem "act_")
META_AD_ACCOUNT_ID=

# Reaproveita o MESMO Supabase do app (audit das propostas). Se vazio, usa arquivo local.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Versão da Marketing API (só mude se souber o que está fazendo)
META_API_VERSION=v21.0

# Pagina do Facebook usada como identidade dos anuncios
META_PAGE_ID=
