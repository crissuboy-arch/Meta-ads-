# Chave gratuita da NVIDIA - obtenha em https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXX

# Opcional: chaves separadas por modelo (evita compartilhar rate limit na arena)
# NVIDIA_API_KEY_LLAMA=nvapi-...
# NVIDIA_API_KEY_LLAMA405=nvapi-...
# NVIDIA_API_KEY_DEEPSEEK=nvapi-...
# NVIDIA_API_KEY_QWEN=nvapi-...
# NVIDIA_API_KEY_GLM=nvapi-...
# NVIDIA_API_KEY_NEMOTRON=nvapi-...
# NVIDIA_API_KEY_MISTRAL=nvapi-...
# NVIDIA_API_KEY_VISION=nvapi-...

# OpenRouter (opcional) - chave em https://openrouter.ai/keys
# Modelos :free = custo zero (texto: Llama 3.3 70B; visao: Gemma 4 31B)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_HTTP_REFERER=https://seu-dominio.com

# Agnes AI (opcional, gratuito) - chave em https://agnes-ai.com
# Texto: agnes-2.0-flash (API compativel com OpenAI, com retry automatico de 503)
# AGNES_API_KEY=...
# AGNES_TEXT_MODEL=agnes-2.0-flash

# Anthropic Claude (opcional, PAGO por uso) - chave em https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5

# OpenAI GPT (opcional, PAGO por uso) - chave em https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o

# Claude package access (Hotmart webhook + admin test accounts)
# Hotmart: Tools -> Webhook -> version 2.0.0 -> your "hottok"
# HOTMART_HOTTOK=
# Comma-separated e-mails that can always download the package (your own account)
# APP_ADMIN_EMAILS=you@example.com

# Conectar contas de anuncios (Meta) - app em https://developers.facebook.com/apps
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=https://SEU-DOMINIO.vercel.app/api/ads/meta/callback
# CRON_SECRET=uma-string-longa-aleatoria   (sincronizacao diaria automatica)

# Athena Control — integração somente-leitura (ver docs/integrations-athena.md)
# Chave EXCLUSIVA desta integração; gerar um valor aleatório e guardar no cofre da Athena.
# EXPERTPRO_ATHENA_API_KEY=

# Cakto (Pix, boleto, cartão): o "secret" do webhook criado na Cakto.
# Se preencher, o app só aceita webhooks da Cakto com assinatura válida.
# CAKTO_WEBHOOK_SECRET=
